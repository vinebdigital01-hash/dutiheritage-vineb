# =============================================================================
# Duti Heritage — Environment Variables
# Copy to .env.local and fill in real values. Never commit .env.local.
# =============================================================================

# --- App ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- MongoDB Atlas ---
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/dutiheritage?retryWrites=true&w=majority

# --- Firebase (client — already used by the storefront) ---
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# --- Firebase Admin (server — verify ID tokens on /api) ---
# Paste the full service-account JSON as a single line, OR use the three fields below.
FIREBASE_SERVICE_ACCOUNT_JSON=
# FIREBASE_ADMIN_PROJECT_ID=
# FIREBASE_ADMIN_CLIENT_EMAIL=
# FIREBASE_ADMIN_PRIVATE_KEY=

# --- Admin access (comma-separated emails) ---
ADMIN_EMAILS=admin@dutiheritage.com

# --- Cron / internal jobs (Authorization: Bearer <secret>) ---
CRON_SECRET=change-me-to-a-long-random-string

# --- Razorpay (Phase 4) ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_WEBHOOK_SECRET=

# --- Cloudinary (Phase 7 image uploads) ---
# Client compresses images first (max 2000px, quality ~0.92), then uploads here.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Resend email (Phase 9) ---
RESEND_API_KEY=
EMAIL_FROM=Duti Heritage <orders@dutiheritage.com>

# --- WhatsApp (Phase 9 — optional) ---
# Provider: interakt | wati | none
WHATSAPP_PROVIDER=none
INTERAKT_API_KEY=
# WATI_API_URL=https://live-server-xxxx.wati.io
# WATI_API_TOKEN=
# Optional pre-approved template names:
# WA_TEMPLATE_WELCOME=
# WA_TEMPLATE_ORDER_PLACED=
# WA_TEMPLATE_ORDER_SHIPPED=
# WA_TEMPLATE_ORDER_DELIVERED=
# WA_TEMPLATE_CART_ABANDONED=
# WA_TEMPLATE_WINBACK=

# --- Meta Pixel (optional) ---
NEXT_PUBLIC_FACEBOOK_PIXEL_ID=

# --- Test suite (see .env.test.example / TESTING.md) ---
# TEST_BASE_URL=http://localhost:3000
# TEST_ADMIN_EMAIL=
# TEST_ADMIN_PASSWORD=
# TEST_CUSTOMER_EMAIL=
# TEST_CUSTOMER_PASSWORD=
