# =============================================================================
# Test credentials — copy values into .env or .env.local (never commit secrets)
# =============================================================================

# Server under test
TEST_BASE_URL=http://localhost:3000

# Admin Firebase user (email MUST be listed in ADMIN_EMAILS)
TEST_ADMIN_EMAIL=your-admin@example.com
TEST_ADMIN_PASSWORD=your-admin-password

# Optional non-admin Firebase user (for 403 guard tests)
TEST_CUSTOMER_EMAIL=
TEST_CUSTOMER_PASSWORD=

# Optional: let Playwright start `npm run start` if no server is running
# PW_WEB_SERVER=1
